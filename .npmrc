; Supply-chain hardening — see plan §16
; Disable lifecycle scripts on install to neutralize post-install attack vector.
; Allow-list specific scripts via package.json "scripts.preinstall" or explicit
; opt-in (e.g. `npm rebuild esbuild prisma`) after a fresh `npm ci --ignore-scripts`.
ignore-scripts=true

; Always use the exact registry; no fallbacks.
registry=https://registry.npmjs.org/

; Save exact versions, never carets/tildes (belt and suspenders alongside lockfile).
save-exact=true

; Fail loudly on lockfile drift in CI.
fund=false
audit=false
