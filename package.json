  "_supply_chain_notes": {
    "policy": "All versions are exact-pinned (no ^ or ~). Bumps go through the §16 cooling-off process: wait ≥7 days after release, review changelog, run scripts/verify-deps.sh, commit lockfile change in isolation.",
