{
  "name": "home-decor-tour",
  "version": "0.0.0",
  "private": true,
  "description": "Tur Dekorasi Rumah — 3D home decor and renovation planner for the Indonesian market.",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
